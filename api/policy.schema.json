{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offense.dev/raid/v1alpha1/policy.schema.json",
  "title": "Raid PolicyBundle",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "defaults", "rules"],
  "properties": {
    "apiVersion": { "const": "offense.dev/raid/v1alpha1" },
    "kind": { "const": "PolicyBundle" },
    "metadata": {
      "type": "object",
      "required": ["name", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["effect"],
      "properties": { "effect": { "enum": ["allow", "deny"] } }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "semantic_guard": { "$ref": "#/$defs/semantic_guard" },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "input", "expect"],
        "properties": {
          "name": { "type": "string" },
          "input": { "type": "string", "description": "relative path to a request JSON file" },
          "expect": {
            "type": "object",
            "properties": {
              "effect": { "enum": ["allow", "deny", "require_approval"] },
              "matched_rules": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "effect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "description": { "type": "string" },
        "priority": { "type": "integer", "default": 0 },
        "match": {
          "type": "object",
          "properties": {
            "providers": { "type": "array", "items": { "type": "string" } },
            "operations": { "type": "array", "items": { "type": "string" } },
            "effects": { "type": "array", "items": { "enum": ["read", "write", "delete", "execute", "admin"] } },
            "environments": { "type": "array", "items": { "type": "string" } }
          }
        },
        "when": { "type": "string", "description": "CEL condition; must evaluate to bool" },
        "effect": { "enum": ["allow", "deny", "require_approval"] },
        "approval": {
          "type": "object",
          "required": ["approver_groups", "quorum", "ttl", "allow_scope"],
          "properties": {
            "approver_groups": { "type": "array", "items": { "type": "string" } },
            "quorum": { "type": "integer", "minimum": 1 },
            "ttl": { "type": "string", "pattern": "^([0-9]+)(ms|s|m|h|d)$" },
            "allow_scope": { "enum": ["exact_request", "operation", "session"], "default": "exact_request" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "effect": { "const": "require_approval" } } },
          "then": { "required": ["approval"], "properties": { "approval": { "minProperties": 4 } } }
        }
      ]
    },
    "semantic_guard": {
      "type": "object",
      "required": ["provider", "model", "mode", "deadline", "failure_effect"],
      "properties": {
        "provider": { "const": "typesafe" },
        "model": { "type": "string" },
        "mode": { "enum": ["off", "shadow", "enforce"] },
        "deadline": { "type": "integer", "minimum": 1 },
        "failure_effect": { "enum": ["require_approval", "deny"] },
        "state_template": { "type": "string" },
        "questions": { "type": "string" },
        "thresholds": { "type": "object", "additionalProperties": { "type": "number" } },
        "escalation": {
          "type": "object",
          "properties": { "effect": { "enum": ["require_approval", "deny"] } }
        }
      }
    }
  }
}